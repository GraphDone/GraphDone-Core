{
  "name": "@graphdone/mcp-server",
  "version": "0.3.1-alpha",
  "description": "MCP server for GraphDone graph operations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "echo 'MCP server should be started by Claude Code, not npm run dev. Use npm run dev:mcp to start manually.'",
    "dev:start": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:contract:local": "RUN_DB_CONTRACT=1 vitest --run tests/neo4j-contract.test.ts",
    "test:integration:local": "GRAPHDONE_MCP_INTEGRATION_REQUIRED=1 vitest --run tests/real-database-integration.test.ts tests/mock-validation.test.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "ci:safe": "npm run lint && npm run typecheck && npm run test",
    "ci:full:local": "npm run ci:safe && npm run test:integration:local"
  },
  "dependencies": {
    "@graphdone/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.0",
    "neo4j-driver": "^5.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
